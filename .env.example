# LLM für die ?-Taste im Editor (OpenAI-kompatible Schnittstelle).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-...
LLM_MODEL=deepseek-flash
# Optional: low | medium | high – leer lassen für schnelle Antworten
LLM_REASONING_EFFORT=

# Modell für Claude Code: „Frage zur Folie“ (Claude Code), „Folie umbauen“ und „Neue Präsentation“ (läuft über den claude-Befehl und dein Abo, kein Schlüssel nötig).
# Möglich z. B.: claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5

# Reasoning effort für Claude Code: low | medium | high | xhigh | max – leer = Standard von Claude Code.
# Getrennt für „Frage zur Folie“ (eher niedrig = schnelle Antworten) und für „Folie umbauen“/„Neue Präsentation“.
CLAUDE_EFFORT_FRAGEN=
CLAUDE_EFFORT_UMBAU=

# OpenAI Codex für „Frage zur Folie“ (Auswahl „OpenAI Codex“): läuft über den codex-Befehl und dein ChatGPT-Konto
# („codex login“), kein API-Schlüssel nötig. Modell leer = Standard von Codex.
# Reasoning effort: minimal | low | medium | high | xhigh – leer = Standard.
CODEX_MODEL=
CODEX_EFFORT_FRAGEN=

# Gewählte Präsentation; wird vom Präsentator gesetzt (Auswahl „Präsentation“). Leer = dieser Projektordner.
INHALT=
