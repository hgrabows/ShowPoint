# Settings for ShowPoint. Copy this file to .env and fill in what you need; empty = default.
# Some key names are German: KI = AI, FRAGEN = asking ("Ask about slide"), UMBAU = rebuilding and creating,
# INHALT = content (the chosen presentation).

# Which AI answers questions, rebuilds slides and creates new presentations: claude | codex | gemini | custom
# (can also be chosen in the presenter under "AI"). Empty = Claude Code, or Codex if only that is installed.
KI=

# Own provider (KI=custom), OpenAI-compatible: asking goes to it directly; rebuilding and creating run through the
# Codex CLI with this provider, so the codex command must be installed and the provider must offer OpenAI's
# "Responses" interface.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-...
LLM_MODEL=deepseek-flash
# Optional: low | medium | high – leave empty for quick answers
LLM_REASONING_EFFORT=

# Claude Code (KI=claude): runs through the claude command and your subscription, no API key needed.
# Model, e.g.: claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max – empty = Claude Code's default.
# Separate for asking (rather low = quick answers) and for rebuilding/creating.
CLAUDE_EFFORT_FRAGEN=
CLAUDE_EFFORT_UMBAU=

# OpenAI Codex (KI=codex): runs through the codex command and your ChatGPT account ("codex login"), no API key needed.
# Model empty = Codex's default. Reasoning effort: minimal | low | medium | high | xhigh – empty = default.
CODEX_MODEL=
CODEX_EFFORT_FRAGEN=
CODEX_EFFORT_UMBAU=

# Gemini through Google's Antigravity CLI (KI=gemini): runs through the agy command and your Google account, no key.
# Model empty = agy's default (list: "agy models"). Effort: low | medium | high | xhigh | max – empty = default.
GEMINI_MODEL=
GEMINI_EFFORT_FRAGEN=
GEMINI_EFFORT_UMBAU=

# Chosen presentation; set by the presenter ("Presentation" chooser). Empty = this project folder.
INHALT=
