{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "preserveSymlinks": true,
    "allowJs": true,
    "paths": {
      "showpoint": ["./runtime/index.tsx"],
      "remotion": ["./runtime/index.tsx"]
    }
  },
  "include": ["editor", "runtime", "render", "vorlage/src", "inhalte"]
}
